# Copy this file to .env and fill in real values. NEVER commit .env itself (it is gitignored).

AZURE_SQL_SERVER=dbsvwtt-simulation.database.windows.net
AZURE_SQL_DATABASE=ranking_prototype2026
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER={ODBC Driver 18 for SQL Server}
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no

# Flask session signing key -- required, no hardcoded default. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# One-time SUPERADMIN seed account (db/seed_app_users.py). Leave ADMIN_SEED_PASSWORD blank to
# use the documented default (Admin@123) -- change it via /account/password after first login.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
